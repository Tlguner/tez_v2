###############################################
# Environment template (repo root)
# 1) Copy this file to .env (same folder)
# 2) Fill in values
# 3) Do NOT commit .env (ignored by .gitignore)
###############################################

##########################
# API Keys
##########################
# Google AI Studio / Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIxxxx...replace-with-your-real-key"

# Optional providers
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

##########################
# MCP Server config
##########################
# If set, the Node server will spawn Python using this interpreter.
# Recommended: point to your project virtualenv Python.
# Example absolute path (Windows):
#   E:\\deu\\tez\\proje\\scraped data\\.venv\\Scripts\\python.exe
PYTHON_PATH=""

# Dataset location (optional; default resolved in code)
# DATASET_PATH="Phishing_Email.csv"

##########################
# App / Server misc
##########################
# PORT is not used by the current MCP stdio server.
# PORT=
